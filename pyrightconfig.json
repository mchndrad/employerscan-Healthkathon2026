{
  "include": ["scripts"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "apps",
    "packages"
  ],
  "venvPath": "./scripts",
  "venv": "venv",
  "pythonVersion": "3.13",
  "extraPaths": [
    "./scripts/venv/lib/python3.13/site-packages"
  ],
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}